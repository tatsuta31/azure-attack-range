# コピーして .env にリネームし、Cloud Shell で作った SP の値を入れる（.env は .gitignore 済み）
#   Copy-Item .env.example .env
# docker の --env-file 形式：KEY=VALUE、引用符もスペースも付けない
#
# ARM_* は Terraform（azurerm）が読む。
# コンテナ内の az CLI は docker/sp-login.sh がこの値でログインする（Attack Range 本体の Python が az のログイン情報を使うため）
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=
